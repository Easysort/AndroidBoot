# Reference schema for .env. In practice: keep the real, filled-in version as
# .env.full on the operator laptop (gitignored) and copy it to the phone as .env
# (setup.sh copies .env.full -> .env automatically if present).
ROLE=support                # "main" for the hotspot phone, "support" for the others
MAIN_SSID=example-ssid      # SSID support phones must connect to
MAIN_PSK=example-psk
CHECK_INTERVAL=300          # seconds between watchdog checks

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_BUCKET=argo
SUPABASE_TABLE=phone_metrics
UPLOAD_BUCKET=argo

STATE_DIR="$HOME/.local/state/androidboot"
LOG_DIR="$STATE_DIR/logs"
ERROR_DIR="$STATE_DIR/errors"
SENT_ERROR_DIR="$ERROR_DIR/sent"
TMPDIR="$HOME/.cache/androidboot"
REPO_DIR="/data/data/com.termux/files/home/AndroidBoot"

CAMERA_ID=0
HEALTH_HOST=0.0.0.0
HEALTH_PORT=5000

# Night-time CPU warm-up (reduce cold-shutdown risk). Phone is on charger; extra drain is fine.
KEEPWARM=1
KEEPWARM_START=22
KEEPWARM_END=6
KEEPWARM_MIN_C=15
KEEPWARM_MAX_C=30
