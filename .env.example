# COPY THIS OVER AND CHANGE THE NAME AND PASSWORD OF MAIN

ROLE=main                 # "main" for hotspot phone, "support" for the others
MAIN_SSID=my_internet        # SSID that SUPPORT phones must connect to
MAIN_PSK="my-code"    # PSK for that SSID (support phones use this)
CHECK_INTERVAL=300         # seconds between checks

SUPABASE_URL="https://{your_url}.supabase.co"
SUPABASE_ANON_KEY="{your-secret}"
SUPABASE_BUCKET="{bucket}"
SUPABASE_TABLE="{table}"

GO_API_PORT=8787
STATE_DIR="$HOME/.local/state/phone-metrics"
LOG_DIR="$STATE_DIR/logs"
ERROR_DIR="$STATE_DIR/errors"
SENT_ERROR_DIR="$ERROR_DIR/sent"
TMPDIR="$HOME/.cache/phone-metrics"

CAMERA_ID=0
